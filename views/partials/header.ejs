<header id="siteHeader"<% if (page !== 'index') { %> data-solid="true"<% } %>>
  <div class="navwrap">
    <a href="index.html" class="brand">
      <img class="mark" src="../assets/img/mark_blue.png" alt="<%= t.brandAlt %>">
      <span class="word">ELLIN<small>GENERAL CONTRACTING &amp; TRADING</small></span>
    </a>
    <nav class="mainnav" id="mainNav">
<%_ PAGES.forEach(function (p) { _%>
<%_ var classes = []; if (p === 'contact') classes.push('nav-cta'); if (p === page) classes.push('active'); _%>
      <a href="<%= p %>.html"<% if (classes.length) { %> class="<%= classes.join(' ') %>"<% } %>><%= t.nav[p] %></a>
<%_ }) _%>
      <div class="langsw"><% LANGS.forEach(function (l) { %><a href="<%= l === lang ? page + '.html' : '../' + l + '/' + page + '.html' %>"<% if (l === lang) { %> class="active"<% } %>><%= SITE[l].langName %></a><% }) %></div>
    </nav>
    <button class="burger" id="burgerBtn" aria-label="<%= t.burgerLabel %>"><span></span><span></span><span></span></button>
  </div>
</header>
